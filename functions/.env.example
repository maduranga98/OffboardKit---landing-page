# Copy to functions/.env (git-ignored) for deploys, or functions/.env.local for the emulator.

# Brevo API key (Brevo > SMTP & API > API keys).
BREVO_API_KEY=
# Numeric ID of the Brevo contact list that receives checklist leads.
BREVO_LEADS_LIST_ID=
# A sender address verified in Brevo, e.g. hello@offboardset.com.
BREVO_SENDER_EMAIL=
# Public origin the PDFs are served from. No trailing slash.
DOWNLOAD_BASE_URL=https://offboardset.com

rules_version = '2';

// Lead-capture collections. Only the Admin SDK (Cloud Functions) may touch them:
// the Admin SDK bypasses these rules, so clients are denied everything.
//
// WARNING: this Firebase project is shared with other apps. Deploying this file
// replaces the project's whole Firestore ruleset. Merge the two `match` blocks
// below into the existing rules instead of deploying this file on its own.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{doc} {
      allow read, write: if false;
    }
    match /leads_ratelimit/{doc} {
      allow read, write: if false;
    }
  }
}
